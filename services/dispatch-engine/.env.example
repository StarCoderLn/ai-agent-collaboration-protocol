DATABASE_URL=postgres://user:password@127.0.0.1:5432/aicp
DISPATCH_INTERNAL_TOKEN=replace-with-the-same-token-as-marketplace-api
MARKETPLACE_API_URL=http://127.0.0.1:3100
DISPATCH_HTTP_ADDRESS=127.0.0.1:3200
DISPATCH_PUBLIC_URL=http://127.0.0.1:3200

# 本地体验：内存队列替代 SQS。数据库 agent_credentials.encrypted_secret 只保存
# `local-dev:<agent-id>` 标记，真实共享密钥来自 LOCAL_AGENT_SECRET。
DISPATCH_QUEUE_MODE=local
LOCAL_AGENT_SECRET=replace-with-at-least-16-random-characters

# 新 Agent 自动准入：三次技术调用全部成功后，用一次兼容 OpenAI 协议的模型调用
# 批量评测三份产物。密钥只存在于服务端环境，不会发送给被测 Agent 或前端。
AGENT_ADMISSION_ENABLED=true
# `postgres` 保留原租约 Worker；`temporal` 改由唯一 Temporal Starter/Worker 接管。
AGENT_ADMISSION_ENGINE=postgres
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_ADMISSION_TASK_QUEUE=aicp-agent-admission-v1
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_ADMISSION_EVALUATOR_MODEL=deepseek-chat

# V1 在 V0 合格集合内召回 30 名，正式页面仍只展示既有 Top-3。
MATCHING_SEMANTIC_ENABLED=false
# OPENAI_API_KEY=replace-with-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# V2 默认关闭。先启动带注册表 SHA-256 校验的本机模型服务，再显式填写同一版本；
# Dispatch Engine 只有在 /health 返回完全一致的版本后才会提升并消费 shadow 模型。
MATCHING_V2_SHADOW_ENABLED=false
# MATCHING_V2_MODEL_URL=http://127.0.0.1:3290
# MATCHING_V2_MODEL_VERSION=matching-v2-YYYYMMDDHHMMSS-12345678

# 正式切换后启用同步 V2：硬约束、语义召回和 ONNX 漏斗排序共同组成唯一生产算法。
# 只有真实曝光训练并通过发布门禁的模型可以用于线上；不得把 synthetic 制品切为正式。
MATCHING_V2_ONLINE_ENABLED=false

# 夜间训练复用本机 Temporal，不依赖 AWS。目录必须使用绝对路径，防止服务启动目录
# 改变后把数据集或制品写到意外位置。训练只注册 candidate，不自动进入正式排序。
MATCHING_V2_TRAINING_ENABLED=false
# MATCHING_V2_SERVICE_DIR=/absolute/path/to/services/matching-model
# MATCHING_V2_TRAINING_WORK_DIR=/absolute/path/to/.local/matching-v2/training
# MATCHING_V2_ARTIFACT_DIR=/absolute/path/to/.local/matching-v2/artifacts
# MATCHING_V2_TRAINING_TASK_QUEUE=aicp-matching-v2-training

# AWS 环境改为 sqs，并配置下面三项；本地模式无需填写。
# DISPATCH_QUEUE_MODE=sqs
# DISPATCH_SQS_QUEUE_URL=https://sqs.region.amazonaws.com/account/aicp-dispatch.fifo
# AWS_REGION=ap-southeast-1
# AGENT_CREDENTIALS_KMS_KEY_ID=alias/aicp-agent-credentials
# LocalStack 才设置下面三项；真实 AWS 不得把 endpoint 指向本机。
# AWS_ENDPOINT_URL=http://127.0.0.1:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
