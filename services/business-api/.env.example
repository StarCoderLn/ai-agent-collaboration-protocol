# PostgreSQL 与 SIWE
DATABASE_URL=postgres://user:password@127.0.0.1:5432/aicp
SIWE_EXPECTED_DOMAIN=localhost:3001
SIWE_EXPECTED_URI=http://localhost:3001
SIWE_EXPECTED_CHAIN_ID=1

# 正式注册/轮换凭证使用 AWS KMS；不要把真实 key 或 secret 提交到仓库。
AGENT_CREDENTIALS_KMS_KEY_ID=alias/aicp-agent-credentials

# 浏览器只访问 Business API；下面两项只用于服务端转发到 Go 分发引擎。
DISPATCH_ENGINE_URL=http://127.0.0.1:3200
DISPATCH_INTERNAL_TOKEN=replace-with-at-least-32-random-characters

# Feature 6 USDC 托管同步。正式网把 chainId、Escrow、官方 USDC 地址和起始区块
# 固定为同一份部署产物；本地 Anvil 使用测试 USDC，金额始终是 6 位最小单位整数。
ETHEREUM_RPC_URL=http://127.0.0.1:8545
ESCROW_CHAIN_ID=31337
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ESCROW_PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
ESCROW_START_BLOCK=0
# 默认展示代码中已核验的 Sepolia YD。仅在 YD 重新部署时取消注释并同时覆盖三项；
# YD 只用于跨链余额读取，不参与本项目的 USDC 托管或结算。
# YD_TOKEN_CHAIN_ID=11155111
# YD_TOKEN_ADDRESS=0xf64bE7869CAf8B00E42209A2CEc3e681a448c320
# YD_TOKEN_DECIMALS=18
# 本地 Anvil / 测试体验使用 2；Ethereum 主网 MVP 建议从 6 开始并按金额与实测风险调整。
# 生产环境必须显式设置，不能依赖开发默认值。
ESCROW_REQUIRED_CONFIRMATIONS=2
ESCROW_MAX_BLOCK_SPAN=500
ESCROW_CURSOR_LEASE_MS=60000
ESCROW_EVENT_BATCH_SIZE=500
ESCROW_RECHECK_BATCH_SIZE=100
ESCROW_RECONCILIATION_BATCH_SIZE=100

# 本地 Anvil 才能使用节点解锁账户；生产环境禁止该模式，必须接 KMS/HSM signer。
ESCROW_OPERATOR_MODE=local-unlocked
ESCROW_OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000
ESCROW_EXECUTION_LEASE_MS=60000
ESCROW_EXECUTION_MAX_ATTEMPTS=5
ESCROW_EXECUTION_RETRY_MS=5000
