{
  "name": "business-api",
  "version": "0.0.0",
  "private": true,
  "description": "Agent 注册与凭证管理的业务 API：独立部署的 Next.js API-only 应用（仅 Route Handlers，无页面）+ AWS Lambda；领域逻辑保持框架无关，路由挂载与认证装配见 T-010/T-011/T-012。",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "next build",
    "start": "next start",
    "infra:build-lambda": "bash infra/build-lambda.sh",
    "infra:synth": "pnpm infra:build-lambda && cd infra && npx cdk synth",
    "infra:diff": "pnpm infra:build-lambda && cd infra && npx cdk diff",
    "infra:deploy": "pnpm infra:build-lambda && cd infra && npx cdk deploy"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.679.0",
    "ethers": "^6.17.0",
    "js-sha3": "^0.13.0",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "siwe": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "aws-cdk": "^2.1138.0",
    "aws-cdk-lib": "^2.266.0",
    "constructs": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
