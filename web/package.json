{
	"name": "web",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "node ../scripts/sepolia-mvp.mjs --ui",
		"build": "pnpm -r --if-present build",
		"test": "pnpm -r --if-present test",
		"check-types": "pnpm -r check-types",
		"dev:web": "pnpm --filter web dev",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@tanstack/react-query": "^5.101.4",
		"@web/env": "workspace:*",
		"dotenv": "catalog:",
		"viem": "^2.55.19",
		"wagmi": "^3.7.6",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "^22.20.1",
		"@web/config": "workspace:*",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@11.18.0"
}
