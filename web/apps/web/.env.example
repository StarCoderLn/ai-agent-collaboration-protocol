# 既有业务 API 的浏览器公开地址。
NEXT_PUBLIC_MARKETPLACE_API_URL=http://127.0.0.1:3000/api

# wagmi/viem 浏览器端本地链配置。正式环境可删除本地 RPC，并由 SIWE challenge 要求
# 切换到已配置的 Ethereum 主网或 Sepolia。
NEXT_PUBLIC_ETHEREUM_RPC_URL=http://127.0.0.1:8545

# 交易详情页只把这些地址产生的日志解释为 AICP 业务事件；地址属于公开链上配置，
# 不包含任何 Operator 私钥或服务端凭据。切换网络时必须与实际部署结果同步更新。
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ESCROW_PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ARBITRATION_DAO_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ARBITRATION_DAO_YD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# 仅本地 Anvil 完整闭环使用。服务器端再次校验所有地址必须是 loopback，内部 token
# 不得添加 NEXT_PUBLIC_ 前缀。生产环境必须删除/关闭这些变量。
NEXT_PUBLIC_AICP_LOCAL_DEMO_MODE=false
AICP_LOCAL_DEMO_MODE=false
LOCAL_DEMO_MARKETPLACE_API_URL=http://127.0.0.1:3000
LOCAL_DEMO_ETHEREUM_RPC_URL=http://127.0.0.1:8545
LOCAL_DEMO_MINE_BLOCKS=2
DISPATCH_INTERNAL_TOKEN=replace-with-the-same-local-internal-token
