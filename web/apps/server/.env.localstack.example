# 复制为 `.env.localstack.local` 后填写。目标文件已被 `.gitignore` 排除，禁止提交真实值。
LOCALSTACK_AUTH_TOKEN=

# 宿主机 AWS CLI/CDK 与 Lambda 容器位于不同网络命名空间，因此必须使用不同地址。
AWS_ENDPOINT_URL=http://127.0.0.1:4566
LOCALSTACK_LAMBDA_AWS_ENDPOINT_URL=http://host.docker.internal:4566
AWS_REGION=us-east-1

# 可选：只有本机测试数据库没有使用默认的 55432 端口时才覆盖。
# LOCALSTACK_DATABASE_URL=postgres://aicp_test:aicp_test_password@host.docker.internal:55432/aicp_test
