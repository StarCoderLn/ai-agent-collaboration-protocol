# 可以先 source ../paper-writing/.env 复用已经配置好的 DeepSeek Key。
DATABASE_URL=postgres://user:password@127.0.0.1:5432/aicp
# 模型层统一使用 provider/base URL/key/model；切换 OpenAI 只需修改这四项。
WORKFLOW_MODEL_PROVIDER=deepseek
WORKFLOW_MODEL_API_KEY=replace-with-your-model-key
WORKFLOW_MODEL_BASE_URL=https://api.deepseek.com
WORKFLOW_AGENT_MODEL=deepseek-chat
# 旧 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL 仍可读取，供现有本机配置平滑迁移。

# 本地体验可与论文 Agent 使用同一个 HMAC secret；正式部署必须为服务分别轮换。
WORKFLOW_AGENT_SECRET=replace-with-at-least-16-random-characters
WORKFLOW_AGENT_HOST=127.0.0.1
WORKFLOW_AGENT_PORT=9202
