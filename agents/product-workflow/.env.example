# 可以先 source ../paper-writing/.env 复用已经配置好的 DeepSeek Key。
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
WORKFLOW_AGENT_MODEL=deepseek-chat

# 本地体验可与论文 Agent 使用同一个 HMAC secret；正式部署必须为服务分别轮换。
WORKFLOW_AGENT_SECRET=replace-with-at-least-16-random-characters
WORKFLOW_AGENT_HOST=127.0.0.1
WORKFLOW_AGENT_PORT=9202
