AGENT_HOST=127.0.0.1
AGENT_PORT=9304
AGENT_PUBLIC_BASE_URL=http://127.0.0.1:9304
# 可选；设置后平台健康检查和执行请求必须携带同一 Bearer token。
AGENT_API_KEY=

# 复用项目现有 DeepSeek 配置；默认模型为 deepseek-chat。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 可选；只覆盖 Browser Agent 使用的模型，不影响其他 Agent。
# STAGEHAND_DEEPSEEK_MODEL=deepseek-chat
STAGEHAND_MODEL_TIMEOUT_MS=120000
STAGEHAND_HEADLESS=true
STAGEHAND_PAGE_TIMEOUT_MS=30000

# 只由 qa:smoke 使用；默认跟随当前 Sepolia 演示环境，且该命令拒绝访问非本机页面。
STAGEHAND_QA_URL=http://127.0.0.1:3011/tasks
