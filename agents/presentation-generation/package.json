{
  "name": "@aicp/presentation-generation-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @aicp/agent-sdk build",
    "dev": "pnpm dev:watch",
    "dev:watch": "node --env-file-if-exists=../paper-writing/.env --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "dev:server": "node --env-file-if-exists=../paper-writing/.env --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aicp/agent-sdk": "workspace:*",
		"@mastra/core": "1.61.0",
		"pg": "8.23.0",
		"pptxgenjs": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
		"@types/node": "^22.19.0",
		"@types/pg": "8.20.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
