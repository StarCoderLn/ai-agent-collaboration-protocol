PAPER_AGENT_PROVIDER=ollama
PAPER_AGENT_MODEL=gemma4:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# 更快的云端模式：启用时替换上面的供应商和模型配置。
# PAPER_AGENT_PROVIDER=deepseek
# PAPER_AGENT_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# 根目录 local-mvp 启动器会把该密钥传给 9 个正式工作流 Agent；论文 Agent 本身不读取它。
WORKFLOW_AGENT_SECRET=replace-with-at-least-16-random-characters

# 平台上架页使用的统一快速接入入口。
AGENT_HOST=127.0.0.1
AGENT_PORT=9303
AGENT_PUBLIC_BASE_URL=http://127.0.0.1:9303
AGENT_API_KEY=replace-with-at-least-8-characters
